{
  "models": {
    "defaultModel": "builtin:composer-lite",
    "temperature": 0.3,
    "contextWindow": 32768,
    "preferEgpu": true,
    "connections": [
      {
        "id": "builtin",
        "name": "Built-in Composer",
        "type": "builtin",
        "provider": "builtin",
        "enabled": true,
        "baseUrl": "",
        "apiKeyRef": "",
        "models": [
          "builtin:composer-lite",
          "builtin:composer"
        ]
      }
    ]
  },
  "agent": {
    "systemPrompt": "You are working inside Eris, an AI desktop IDE, with the built-in Composer agent stack.\n\nBe concise, accurate, and practical. Prefer concrete file paths and symbols over vague advice. When Agent mode has workspace tools, use them instead of asking the user for project structure or pasted code. Match the project’s existing style. Never invent APIs or claim you changed files unless tools actually did.",
    "includeOpenFiles": true,
    "maxHistoryMessages": 40,
    "autoKeepDiffs": false,
    "commandApproval": "ask",
    "allowedCommands": [],
    "routing": {
      "enabled": true,
      "mode": "auto",
      "routerModel": "builtin:composer-lite",
      "useLlmRouter": false,
      "fallbackAgentId": "composer"
    },
    "constrainLocalToolCalls": true,
    "projectMemory": "auto"
  },
  "intelligence": {
    "embeddingProvider": "auto",
    "embeddingModel": "",
    "languageServers": [
      {
        "id": "python",
        "name": "Python (pyright)",
        "enabled": true,
        "languageId": "python",
        "extensions": [
          "py",
          "pyi"
        ],
        "command": "pyright-langserver",
        "args": [
          "--stdio"
        ]
      },
      {
        "id": "go",
        "name": "Go (gopls)",
        "enabled": true,
        "languageId": "go",
        "extensions": [
          "go"
        ],
        "command": "gopls",
        "args": []
      },
      {
        "id": "rust",
        "name": "Rust (rust-analyzer)",
        "enabled": true,
        "languageId": "rust",
        "extensions": [
          "rs"
        ],
        "command": "rust-analyzer",
        "args": []
      }
    ]
  },
  "evals": {
    "useScoresForRouting": true,
    "minRuns": 3,
    "allowUnsafeCommands": false
  },
  "backgroundAgents": {
    "maxParallel": 2,
    "linkNodeModules": true
  },
  "mcp": {
    "servers": []
  },
  "github": {
    "host": "github.com",
    "tokenRef": "",
    "preferredProtocol": "https",
    "repository": "",
    "remoteName": "origin",
    "defaultBranch": "main",
    "linked": false
  },
  "ericServices": {
    "apiBase": "https://www.ericservic.es",
    "tokenRef": "",
    "linked": false,
    "username": "",
    "email": "",
    "lastSyncedAt": "",
    "syncEnabled": true,
    "plan": "free",
    "planLimits": {}
  },
  "editor": {
    "fontSize": 14,
    "tabSize": 2,
    "theme": "vs-dark",
    "inlineSuggest": true,
    "chatFont": "mono"
  },
  "general": {
    "restoreLastWorkspace": true,
    "updates": {
      "autoCheck": true,
      "autoDownload": true,
      "channel": "stable"
    },
    "logging": {
      "enabled": true,
      "directory": "",
      "level": "info"
    },
    "telemetry": {
      "agentOutcomes": false
    }
  }
}
