{
  "models": {
    "defaultModel": "builtin:composer-lite",
    "temperature": 0.3,
    "contextWindow": 32768,
    "preferEgpu": true,
    "allowCpuSpill": true,
    "connections": [
      {
        "id": "builtin",
        "name": "Built-in Composer",
        "type": "builtin",
        "provider": "builtin",
        "enabled": true,
        "baseUrl": "",
        "apiKeyRef": "",
        "models": [
          "builtin:composer-lite",
          "builtin:composer"
        ]
      }
    ]
  },
  "agent": {
    "systemPrompt": "Shared rules (every role inherits these):\n- Be accurate first, then brief. Name the files and symbols you rely on.\n- Find things out with the tools you have; do not ask the user for project structure or for files already in the workspace.\n- Follow the project's existing style and conventions, and keep changes small and focused on the request.\n- Never invent APIs, file contents or tool results. Say something was changed, run or verified only after a tool showed it.\n- Ask the user only for a real product decision; otherwise choose, and state the assumption.",
    "includeOpenFiles": true,
    "maxHistoryMessages": 40,
    "autoKeepDiffs": false,
    "commandApproval": "ask",
    "allowedCommands": [],
    "routing": {
      "enabled": true,
      "mode": "auto",
      "routerModel": "builtin:composer-lite",
      "useLlmRouter": true,
      "fallbackAgentId": "composer",
      "profile": "auto",
      "preferCloudComposer": true,
      "pinnedAgentId": "auto"
    },
    "constrainLocalToolCalls": true,
    "projectMemory": "auto"
  },
  "intelligence": {
    "embeddingProvider": "auto",
    "embeddingModel": "",
    "languageServers": [
      {
        "id": "python",
        "name": "Python (pyright)",
        "enabled": true,
        "languageId": "python",
        "extensions": [
          "py",
          "pyi"
        ],
        "command": "pyright-langserver",
        "args": [
          "--stdio"
        ]
      },
      {
        "id": "go",
        "name": "Go (gopls)",
        "enabled": true,
        "languageId": "go",
        "extensions": [
          "go"
        ],
        "command": "gopls",
        "args": []
      },
      {
        "id": "rust",
        "name": "Rust (rust-analyzer)",
        "enabled": true,
        "languageId": "rust",
        "extensions": [
          "rs"
        ],
        "command": "rust-analyzer",
        "args": []
      }
    ]
  },
  "evals": {
    "useScoresForRouting": true,
    "minRuns": 3,
    "allowUnsafeCommands": false
  },
  "backgroundAgents": {
    "maxParallel": 2,
    "linkNodeModules": true
  },
  "mcp": {
    "servers": []
  },
  "github": {
    "host": "github.com",
    "tokenRef": "",
    "preferredProtocol": "https",
    "repository": "",
    "remoteName": "origin",
    "defaultBranch": "main",
    "linked": false
  },
  "ericServices": {
    "apiBase": "https://www.ericservic.es",
    "tokenRef": "",
    "linked": false,
    "username": "",
    "email": "",
    "lastSyncedAt": "",
    "syncEnabled": true,
    "plan": "free",
    "planLimits": {}
  },
  "editor": {
    "fontSize": 14,
    "tabSize": 2,
    "theme": "vs-dark",
    "inlineSuggest": true,
    "chatFont": "mono"
  },
  "general": {
    "restoreLastWorkspace": true,
    "updates": {
      "autoCheck": true,
      "autoDownload": true,
      "channel": "stable"
    },
    "logging": {
      "enabled": true,
      "directory": "",
      "level": "info"
    },
    "telemetry": {
      "agentOutcomes": false
    }
  }
}
