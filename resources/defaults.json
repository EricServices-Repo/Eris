{
  "models": {
    "defaultModel": "builtin:composer-lite",
    "temperature": 0.3,
    "contextWindow": 32768,
    "preferEgpu": true,
    "connections": [
      {
        "id": "builtin",
        "name": "Built-in Composer",
        "type": "builtin",
        "provider": "builtin",
        "enabled": true,
        "baseUrl": "",
        "apiKeyRef": "",
        "models": [
          "builtin:composer-lite",
          "builtin:composer"
        ]
      }
    ]
  },
  "agent": {
    "systemPrompt": "You are an agent inside Eris, a desktop AI IDE. The open folder is a real workspace on disk; Agent mode may grant tools to read, search, edit, and run commands.\n\nShared rules (every role inherits these):\n- Be concise and accurate. Cite concrete file paths and symbols.\n- Discover and change the project with tools — do not ask the user for structure or to paste files already in the workspace.\n- Match existing style and conventions; prefer small, focused diffs.\n- Never invent APIs, file contents, or tool results. Only claim edits after tools succeed.\n- If blocked by a true product choice, ask once; otherwise decide and state the assumption.\n- Keep chat narration short; put effort into tools and code.",
    "includeOpenFiles": true,
    "maxHistoryMessages": 40,
    "autoKeepDiffs": false,
    "commandApproval": "ask",
    "allowedCommands": [],
    "routing": {
      "enabled": true,
      "mode": "auto",
      "routerModel": "builtin:composer-lite",
      "useLlmRouter": true,
      "fallbackAgentId": "composer",
      "profile": "auto",
      "preferCloudComposer": true
    },
    "constrainLocalToolCalls": true,
    "projectMemory": "auto"
  },
  "intelligence": {
    "embeddingProvider": "auto",
    "embeddingModel": "",
    "languageServers": [
      {
        "id": "python",
        "name": "Python (pyright)",
        "enabled": true,
        "languageId": "python",
        "extensions": [
          "py",
          "pyi"
        ],
        "command": "pyright-langserver",
        "args": [
          "--stdio"
        ]
      },
      {
        "id": "go",
        "name": "Go (gopls)",
        "enabled": true,
        "languageId": "go",
        "extensions": [
          "go"
        ],
        "command": "gopls",
        "args": []
      },
      {
        "id": "rust",
        "name": "Rust (rust-analyzer)",
        "enabled": true,
        "languageId": "rust",
        "extensions": [
          "rs"
        ],
        "command": "rust-analyzer",
        "args": []
      }
    ]
  },
  "evals": {
    "useScoresForRouting": true,
    "minRuns": 3,
    "allowUnsafeCommands": false
  },
  "backgroundAgents": {
    "maxParallel": 2,
    "linkNodeModules": true
  },
  "mcp": {
    "servers": []
  },
  "github": {
    "host": "github.com",
    "tokenRef": "",
    "preferredProtocol": "https",
    "repository": "",
    "remoteName": "origin",
    "defaultBranch": "main",
    "linked": false
  },
  "ericServices": {
    "apiBase": "https://www.ericservic.es",
    "tokenRef": "",
    "linked": false,
    "username": "",
    "email": "",
    "lastSyncedAt": "",
    "syncEnabled": true,
    "plan": "free",
    "planLimits": {}
  },
  "editor": {
    "fontSize": 14,
    "tabSize": 2,
    "theme": "vs-dark",
    "inlineSuggest": true,
    "chatFont": "mono"
  },
  "general": {
    "restoreLastWorkspace": true,
    "updates": {
      "autoCheck": true,
      "autoDownload": true,
      "channel": "stable"
    },
    "logging": {
      "enabled": true,
      "directory": "",
      "level": "info"
    },
    "telemetry": {
      "agentOutcomes": false
    }
  }
}
