{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./out",
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*",
    "src/shared/**/*",
    "src/state/documents.ts",
    "resources/defaults.json",
    "checks/quality/cases.json",
    "resources/agents.json",
    "src/features/chat/thinking-summary.ts",
    "checks/context-gate.ts",
    "checks/context-recall-labels.ts",
    "tests/**/*",
    "vitest.config.ts",
    "electron.dev.config.ts",
    "cloud-agent/src/workspace-paths.ts",
    "cloud-agent/src/job-sandbox.ts",
    "cloud-agent/src/task-policy.ts",
    "checks/quality/scenarios.json"
  ]
}
