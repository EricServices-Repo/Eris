{
  "name": "eris",
  "version": "0.1.0",
  "description": "Eris — AI-first desktop IDE for macOS",
  "main": "./out/main/index.js",
  "author": "Eris",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac dmg",
    "dist:release": "npm run build && electron-builder --mac dmg zip",
    "start:app": "npm run dist:mac && open \"$(ls -d dist/mac*/Eris.app | head -1)\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:github": "node scripts/release.mjs --no-bump"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "node-llama-cpp": "^3.22.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-monaco-editor": "^0.56.2",
    "typescript-language-server": "^5.3.0",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "app.eris.ide",
    "productName": "Eris",
    "directories": {
      "output": "dist",
      "buildResources": "resources/icons"
    },
    "icon": "resources/icons/icon.png",
    "files": [
      "out/**/*",
      "resources/**/*",
      "node_modules/node-llama-cpp/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/typescript-language-server/**/*",
      "node_modules/vscode-jsonrpc/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EricServices-Repo",
        "repo": "Eris",
        "releaseType": "release"
      }
    ]
  }
}
