{
  "name": "eris",
  "version": "0.2.0",
  "description": "Eris — AI-first desktop IDE for macOS",
  "main": "./out/main/index.js",
  "author": "Eris",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac --dir -c.mac.identity=null",
    "dist:dmg": "npm run build && electron-builder --mac dmg -c.mac.identity=null",
    "dist:release": "npm run build && electron-builder --mac dmg zip",
    "start:app": "npm run dist:mac && open \"$(ls -d dist/mac*/Eris.app | head -1)\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:github": "node scripts/release.mjs --no-bump",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "cloud-agent:build": "npm run build --prefix cloud-agent",
    "cloud-agent:docker": "docker build -t eris-cloud-agent ./cloud-agent"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.22.1",
    "node-pty": "^1.1.0",
    "typescript-language-server": "^5.3.0",
    "vscode-jsonrpc": "^9.0.3",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "monaco-editor": "^0.52.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-monaco-editor": "^0.56.2",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "app.eris.ide",
    "productName": "Eris",
    "directories": {
      "output": "dist",
      "buildResources": "resources/icons"
    },
    "icon": "resources/icons/icon.png",
    "files": [
      "out/**/*",
      "resources/**/*",
      "node_modules/node-llama-cpp/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/typescript-language-server/**/*",
      "node_modules/vscode-jsonrpc/**/*",
      "node_modules/web-tree-sitter/**/*",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**",
      "!node_modules/node-llama-cpp/llama/xpack/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!**/*.{md,map,ts.map}"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@parcel/watcher*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "node_modules/web-tree-sitter/tree-sitter.wasm",
        "to": "resources/grammars/tree-sitter.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-typescript.wasm",
        "to": "resources/grammars/tree-sitter-typescript.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-tsx.wasm",
        "to": "resources/grammars/tree-sitter-tsx.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-javascript.wasm",
        "to": "resources/grammars/tree-sitter-javascript.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-python.wasm",
        "to": "resources/grammars/tree-sitter-python.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-go.wasm",
        "to": "resources/grammars/tree-sitter-go.wasm"
      },
      {
        "from": "node_modules/tree-sitter-wasms/out/tree-sitter-rust.wasm",
        "to": "resources/grammars/tree-sitter-rust.wasm"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EricServices-Repo",
        "repo": "Eris",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "simple-git": "^4.0.2"
  }
}
