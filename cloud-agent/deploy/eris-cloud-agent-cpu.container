# Podman Quadlet — CPU-only Cloud Agent (no NVIDIA device / no GPU toolkit).
#
# Install on a CPU VM:
#   podman build --target runtime-cpu -t eris-cloud-agent:latest ./cloud-agent
#   sudo cp cloud-agent/deploy/eris-cloud-agent-cpu.container /etc/containers/systemd/eris-cloud-agent.container
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eris-cloud-agent.service
#
# Or: ./cloud-agent/scripts/rebuild.sh --cpu --install
#
# Host should have ≥10 GiB RAM free for the 8g cgroup + sshd/OS.
# Inference is slower than GPU. ERIS_CLOUD_MAX_PARALLEL=1.

[Unit]
Description=Eris Cloud Agent CPU-only (agents.ericservic.es:6443)
After=network-online.target
Wants=network-online.target
# Stop death-spiral if the container OOMs at boot
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
# Must exist in *root* Podman storage (build with: sudo podman build …)
Image=localhost/eris-cloud-agent:latest
Pull=never
ContainerName=eris-cloud-agent
# API on :6443; status on host :8080 (nginx :80 → 8080 — see deploy/nginx-eris-cloud-status.conf)
PublishPort=6443:6443
PublishPort=8080:8080
Volume=eris-cloud-data:/var/lib/eris-cloud:Z
Environment=ERIS_CLOUD_PUBLIC_URL=https://agents.ericservic.es:443
Environment=ERIS_CLOUD_HOST=0.0.0.0
Environment=ERIS_CLOUD_PORT=6443
Environment=ERIS_CLOUD_STATUS_PORT=8080
Environment=ERIS_CLOUD_DATA=/var/lib/eris-cloud
Environment=ERIS_CLOUD_MAX_PARALLEL=1
Environment=ERIS_CLOUD_GPU=false
# Leave headroom for sshd — llama defaults otherwise use all math cores.
Environment=ERIS_CLOUD_MAX_THREADS=2
# 2k ctx keeps RSS under the 8g cgroup with Composer Full (~4.7GB weights).
Environment=ERIS_CLOUD_CONTEXT_SIZE=2048
# Do NOT mmap the GGUF at process start (was OOM-killing the VM). Loads on first job.
Environment=ERIS_CLOUD_WARM_ON_START=0
# Link to EricServic.es Admin → Cloud Agents (optional):
# Environment=ERIS_CLOUD_FLEET_ENROLL_TOKEN=enr_…
# Environment=ERIS_CLOUD_FLEET_NAME=prod-cpu-1
# Uncomment and set a long random secret to enable status-page Force kill all:
# Environment=ERIS_CLOUD_ADMIN_TOKEN=
# Hard cap so a runaway job cannot starve SSH (2 CPUs, 8GiB).
PodmanArgs=--cpus=2 --memory=8g --memory-swap=8g
HealthCmd=node -e "fetch('http://127.0.0.1:6443/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=8s
# Allow first-boot Composer Full download (~4.7 GB) before marking unhealthy
HealthStartPeriod=600s
HealthRetries=8

[Service]
Restart=on-failure
RestartSec=45
TimeoutStartSec=900
# Extra safety at the systemd slice level
CPUQuota=200%
MemoryMax=8G

[Install]
WantedBy=multi-user.target
