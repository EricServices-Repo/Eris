# Podman Quadlet — managed by systemd (survives closing the CLI / logout).
#
# System install (recommended on agents.ericservic.es):
#   sudo cp cloud-agent/deploy/eris-cloud-agent.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl start eris-cloud-agent.service
#   sudo systemctl enable eris-cloud-agent.service
#
# Host prerequisites for GPU:
#   - NVIDIA drivers + nvidia-container-toolkit
#   - sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
#
# Build the image first (on the GPU host, preferably amd64):
#   podman build -t eris-cloud-agent ./cloud-agent

[Unit]
Description=Eris Cloud Agent (agents.ericservic.es:6443)
After=network-online.target
Wants=network-online.target

[Container]
# Must exist in *root* Podman storage (build with: sudo podman build …)
Image=localhost/eris-cloud-agent:latest
Pull=never
ContainerName=eris-cloud-agent
PublishPort=6443:6443
Volume=eris-cloud-data:/var/lib/eris-cloud:Z
Environment=ERIS_CLOUD_PUBLIC_URL=http://agents.ericservic.es:6443
Environment=ERIS_CLOUD_HOST=0.0.0.0
Environment=ERIS_CLOUD_PORT=6443
Environment=ERIS_CLOUD_DATA=/var/lib/eris-cloud
Environment=ERIS_CLOUD_MAX_PARALLEL=2
Environment=ERIS_CLOUD_GPU=auto
# NVIDIA GPU via CDI (Container Device Interface)
AddDevice=nvidia.com/gpu=all
PodmanArgs=--security-opt=label=disable
HealthCmd=node -e "fetch('http://127.0.0.1:6443/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=8s
# Allow first-boot Composer Full download (~4.7 GB) before marking unhealthy
HealthStartPeriod=600s
HealthRetries=8

[Service]
Restart=always
# Long enough for image pull + model warm on cold start
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
