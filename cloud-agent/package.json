{
  "name": "@eris/cloud-agent",
  "version": "0.2.18",
  "private": true,
  "description": "Eris Cloud Agent worker — runs agent jobs for all Eris installs",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:build": "docker build -t eris-cloud-agent:latest .",
    "docker:build:cpu": "docker build --target runtime-cpu -t eris-cloud-agent:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:up:cpu": "docker compose -f docker-compose.cpu.yml up -d --build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
