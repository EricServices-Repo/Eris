{
  "extends": null,
  "appId": "app.eris.dev",
  "productName": "Eris-Dev",
  "extraMetadata": { "name": "eris-dev", "main": "./out-dev/main/index.js" },
  "directories": { "output": "dist-dev" },
  "files": [
    "out-dev/**/*",
    "resources/defaults.json",
    "resources/agents.json",
    "resources/models/**/*"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources",
      "filter": ["**/*", "!eris-feedback-token", "!app-update.yml"]
    }
  ],
  "asarUnpack": [
    "node_modules/node-llama-cpp/**/*",
    "node_modules/node-pty/**/*",
    "node_modules/@parcel/watcher*/**/*"
  ],
  "mac": { "target": ["dir"], "identity": null, "icon": "resources/icons/icon.icns" },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "resources/icons/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
  },
  "publish": null
}
