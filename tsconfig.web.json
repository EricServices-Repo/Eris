{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*", "checks/context-*-check.ts", "checks/capabilities-renderer.tsx",
    "checks/client-renderer.tsx", "checks/ux-renderer.tsx",
    "checks/performance-renderer.tsx", "checks/accessibility-renderer.tsx"
  ]
}
